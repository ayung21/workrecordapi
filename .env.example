DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workrecord?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WorkRecord <noreply@workrecord.id>"

# Payment gateway: bimasakti (default, stub) | midtrans
PAYMENT_GATEWAY=bimasakti

# Midtrans (opsional)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# Pricing (IDR)
PRICE_SUBSCRIPTION_MONTHLY=500000
PRICE_VIEW_HOUR=25000
PRICE_VIEW_DAY=75000
PRICE_VIEW_MONTH=200000
