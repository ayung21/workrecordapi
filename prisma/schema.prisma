generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserAccountType {
  ADMIN
  LEADERSHIP
  MEMBER
}

enum CompanySurveyStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  PENDING_SURVEY
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentType {
  SUBSCRIPTION
  VIEW_ACCESS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ViewAccessScope {
  SINGLE_EMPLOYEE
  ALL_COMPANY
}

enum ViewDurationUnit {
  HOUR
  DAY
  MONTH
}

enum RecordChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum RecordChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  LIVE
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model RoleGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]
}

model Role {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  description  String?
  roleGroupId  String
  roleGroup    RoleGroup        @relation(fields: [roleGroupId], references: [id])
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  users        User[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Company {
  id              String              @id @default(uuid())
  name            String
  companyPhone    String
  adminPublicId   String              @unique
  leaderPublicId  String?             @unique
  leadershipInvitedAt DateTime?
  surveyStatus    CompanySurveyStatus @default(PENDING)
  surveyNotes     String?
  verifiedAt      DateTime?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           User[]
  employeeRecords EmployeeRecord[]
  subscriptions   Subscription[]
  payments        Payment[]
  disputes        Dispute[]
  changeRequests  RecordChangeRequest[]
}

model User {
  id                    String          @id @default(uuid())
  publicLoginId         String          @unique
  email                 String          @unique
  emailVerifiedAt       DateTime?
  passwordHash          String
  fullName              String
  personalPhone         String?
  accountType           UserAccountType @default(MEMBER)
  roleId                String
  role                  Role            @relation(fields: [roleId], references: [id])
  companyId             String?
  company               Company?        @relation(fields: [companyId], references: [id])
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  subscriptions         Subscription[]
  payments              Payment[]
  viewAccessGrants      ViewAccessGrant[]
  requestedChanges      RecordChangeRequest[] @relation("RequestedBy")
  approvedChanges       RecordChangeRequest[] @relation("ApprovedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  disputesFiled         Dispute[]       @relation("DisputeReporter")
}

model Subscription {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  status      SubscriptionStatus @default(PENDING_PAYMENT)
  startsAt    DateTime?
  endsAt      DateTime?
  paymentId   String?            @unique
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, companyId])
  @@index([status, endsAt])
}

model Payment {
  id              String        @id @default(uuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("IDR")
  gateway         String        @default("mock")
  gatewayOrderId  String        @unique
  gatewayTxnId    String?
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscription    Subscription?
  viewAccessGrant ViewAccessGrant?
}

model ViewAccessGrant {
  id               String           @id @default(uuid())
  tokenHash        String           @unique
  email            String
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  paymentId        String           @unique
  payment          Payment          @relation(fields: [paymentId], references: [id])
  scope            ViewAccessScope
  companyId        String
  employeeRecordId String?
  employeeRecord   EmployeeRecord?  @relation(fields: [employeeRecordId], references: [id])
  durationUnit     ViewDurationUnit
  durationValue    Int
  startsAt         DateTime         @default(now())
  endsAt           DateTime
  createdAt        DateTime         @default(now())

  @@index([endsAt])
  @@index([companyId])
}

model EmployeeRecord {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  employeeName    String
  employeeIdNumber String?
  position        String?
  joinedAt        DateTime?
  leftAt          DateTime?
  conductSummary  String?
  violationNotes  String?
  isPublicPreview Boolean             @default(true)
  deletedAt       DateTime?
  liveData        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  changeRequests  RecordChangeRequest[]
  viewAccessGrants ViewAccessGrant[]
  disputes        Dispute[]

  @@index([companyId])
  @@index([deletedAt])
}

model RecordChangeRequest {
  id               String             @id @default(uuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  employeeRecordId String?
  employeeRecord   EmployeeRecord?    @relation(fields: [employeeRecordId], references: [id])
  action           RecordChangeAction
  status           RecordChangeStatus @default(PENDING_APPROVAL)
  payload          Json
  requestedById    String
  requestedBy      User               @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?              @relation("ApprovedBy", fields: [approvedById], references: [id])
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  appliedAt        DateTime?

  @@index([companyId, status])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Dispute {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  employeeRecordId String?
  employeeRecord   EmployeeRecord? @relation(fields: [employeeRecordId], references: [id])
  reporterUserId   String?
  reporterUser     User?         @relation("DisputeReporter", fields: [reporterUserId], references: [id])
  reporterEmail    String
  description      String
  status           DisputeStatus @default(OPEN)
  resolutionNotes  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, status])
}

enum AuditAction {
  AUTH_LOGIN
  AUTH_PASSWORD_CHANGE
  COMPANY_REGISTER
  COMPANY_SURVEY_UPDATE
  LEADERSHIP_INVITE
  SUBSCRIPTION_ACTIVATED
  PAYMENT_COMPLETED
  RECORD_CREATE
  RECORD_UPDATE
  RECORD_DELETE
  RECORD_CHANGE_APPROVED
  RECORD_CHANGE_REJECTED
  VIEW_ACCESS_GRANTED
  DISPUTE_CREATED
  DISPUTE_STATUS_UPDATE
}

model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  actorUserId  String?
  companyId    String?
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
